{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/carloshernanic/openlogo/schema/brand.schema.json",
  "title": "OpenLogo brand",
  "description": "Metadados de uma marca em brands/<slug>/brand.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "website", "category", "colors", "aliases"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "description": "Nome da marca como o usuário reconhece.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "slug": {
      "description": "Identificador único, igual ao nome da pasta.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 50
    },
    "website": {
      "description": "Site oficial da marca.",
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "category": {
      "type": "string",
      "enum": [
        "bank",
        "delivery",
        "education",
        "fintech",
        "food",
        "fuel",
        "games",
        "health",
        "pharmacy",
        "retail",
        "software",
        "streaming",
        "supermarket",
        "telecom",
        "transport",
        "travel",
        "other"
      ]
    },
    "colors": {
      "description": "Cores da marca em hex. A primeira é a principal.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
    },
    "aliases": {
      "description": "Como a marca aparece em extratos. Nunca inclua dados pessoais.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 }
    },
    "cnpjRoots": {
      "description": "Raiz do CNPJ (8 primeiros dígitos) das empresas da marca.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{8}$" }
    },
    "logoStatus": {
      "description": "\"missing\" quando ainda não há logo.svg com origem confiável.",
      "type": "string",
      "enum": ["ok", "missing"],
      "default": "ok"
    },
    "logoSource": {
      "description": "De onde veio o SVG (ex: simple-icons, site oficial).",
      "type": "string",
      "maxLength": 200
    }
  }
}
