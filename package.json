{
  "name": "openlogo",
  "version": "0.1.0",
  "description": "Identifica a marca por trás de descritores de extratos bancários brasileiros e devolve a logo em SVG.",
  "license": "MIT",
  "author": "carloshernanic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carloshernanic/openlogo.git"
  },
  "keywords": [
    "logo",
    "brand",
    "extrato",
    "banco",
    "transacao",
    "conciliacao",
    "brasil"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LOGOS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "validate:brands": "tsx scripts/validate-brands.ts",
    "build:index": "tsx scripts/build-index.ts",
    "prebuild": "npm run build:index",
    "pretest": "npm run build:index",
    "pretypecheck": "npm run build:index",
    "prepack": "npm run build",
    "import:icon": "tsx scripts/import-simple-icons.ts",
    "accuracy": "tsx scripts/accuracy.ts",
    "preaccuracy": "npm run build:index",
    "validate:svgs": "tsx scripts/validate-svgs.ts",
    "validate": "npm run validate:brands && npm run validate:svgs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "simple-icons": "16.36.0",
    "svgo": "^4.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
